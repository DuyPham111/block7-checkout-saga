# better-sqlite3 13 đã kèm binary build sẵn (prebuilds/) cho Windows, Linux, macOS.
# Tắt install script để npm ci không gọi node-gyp (vốn cần Visual Studio C++ trên Windows).
# Không gói nào trong dự án cần install script: @parcel/watcher dùng binary theo nền tảng, @scarf/scarf chỉ là telemetry.
ignore-scripts=true
